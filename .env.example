# Copy to .env and adjust. Real environment variables take precedence over this file.

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMASEARCH_MODEL=qwen3.5:2b
# false (default) | true | auto  (thinking models only; off is faster and scores better on small models)
OLLAMASEARCH_THINK=false
OLLAMASEARCH_NUM_CTX=8192
# hard cap on generated tokens per call (stops degenerate small models looping forever)
OLLAMASEARCH_MAX_TOKENS=1024
OLLAMASEARCH_TEMPERATURE=0
OLLAMASEARCH_SEED=42
# seconds to wait for Ollama before giving up on a response (big models on CPU may need more)
OLLAMASEARCH_LLM_TIMEOUT=300

# Search
OLLAMASEARCH_BACKEND=searxng
SEARXNG_URL=http://127.0.0.1:8080
# Only needed for --backend ollama (Ollama's hosted web search; queries leave your machine)
# OLLAMA_API_KEY=

# Retrieval
OLLAMASEARCH_TOP_K=5
OLLAMASEARCH_SOURCE_CHARS=1500
OLLAMASEARCH_CONTEXT_CHARS=6000
OLLAMASEARCH_MAX_STEPS=4

# Fetching
OLLAMASEARCH_CONNECT_TIMEOUT=5
OLLAMASEARCH_READ_TIMEOUT=15
OLLAMASEARCH_FETCH_CONCURRENCY=8
OLLAMASEARCH_MAX_PAGE_BYTES=3000000
# use the OS certificate store (fixes some sites with incomplete TLS chains)
OLLAMASEARCH_TRUSTSTORE=true
# default: ~/.cache/ollamasearch ; set to "off" to disable the page cache
# OLLAMASEARCH_CACHE_DIR=off
